# ========== 开发环境配置（真实微信登录） ==========
# 配置了 WX_APP_ID + WX_APP_SECRET 后将使用真实微信登录
# 支付仍为 Mock 模式（未配置微信支付商户信息）

# 服务端口
PORT=8080

# JWT 密钥（真实模式要求至少 32 字符）
JWT_SECRET=aipic_dev_jwt_secret_key_2026_11_03

# 数据库路径
DB_PATH=./data/aipic.db

# 上传目录
UPLOAD_DIR=./uploads

# 最大上传大小（5MB）
MAX_UPLOAD_SIZE=5242880

# JWT 过期时间（小时）
JWT_EXPIRE_HOURS=2
REFRESH_EXPIRE_HOURS=168

# ========== 微信小程序配置 ==========
WX_APP_ID=wx6fd7e11aca5fb41e
# 请填入你的 AppSecret（微信公众平台 → 开发 → 开发管理 → 开发设置）
WX_APP_SECRET=

# ========== 微信支付配置（开发阶段不配置，使用 Mock 支付） ==========
# WX_MCH_ID=
# WX_MCH_KEY=
# WX_MCH_CERT_SERIAL=
# WX_MCH_PRIVATE_KEY_PATH=
# WX_NOTIFY_URL=
